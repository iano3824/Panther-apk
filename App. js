import React, { useState, useEffect } from 'react';
import { StyleSheet, Text, View, TouchableOpacity, ScrollView, Alert, StatusBar } from 'react-native';

export default function App() {
  const [tab, setTab] = useState('Wallet');
  const [balance, setBalance] = useState(850);
  const [type, setType] = useState('demo');
  const [price, setPrice] = useState(4123.48);

  useEffect(() => {
    const i = setInterval(()=> setPrice(p=>p+(Math.random()-0.5)*3), 1200);
    return ()=>clearInterval(i);
  },[]);

  const resetDemo = () => {
    if(type==='demo'){
      setBalance(10000);
      Alert.alert('🐆 Wakanda!','Demo reset to $10,000 - Trade again!');
    }
  };

  return (
    <View style={s.container}>
      <StatusBar barStyle="light-content" />
      <View style={s.header}>
        <Text style={s.title}>🐆 PANTHER CHAT</Text>
        <Text style={s.sub}>Standalone APK • {type.toUpperCase()} ${balance} • SDK 57</Text>
      </View>

      {tab==='Chats' && (
        <ScrollView style={{padding:10}}>
          <View style={s.card}><Text style={s.name}>Okoye 🛡️</Text><Text style={s.msg}>Border secured - Wakanda Forever ✓✓</Text></View>
          <View style={s.card}><Text style={s.name}>Shuri 🔬</Text><Text style={s.msg}>APK build ready! Vibranium secure.</Text></View>
          <View style={s.card}><Text style={s.name}>T'Challa 👑</Text><Text style={s.msg}>Team briefing 09:30</Text></View>
        </ScrollView>
      )}

      {tab==='Trade' && (
        <View style={{padding:20, alignItems:'center'}}>
          <Text style={{color:'#D4AF37', fontSize:12}}>Volatility 75 • LIVE</Text>
          <Text style={s.big}>{price.toFixed(2)}</Text>
          <TouchableOpacity style={s.gold} onPress={()=>Alert.alert('Trade','Rise $1 placed')}><Text style={s.btnT}>RISE 📈 $1</Text></TouchableOpacity>
          <TouchableOpacity style={s.dark} onPress={()=>Alert.alert('Trade','Fall $1 placed')}><Text style={s.darkT}>FALL 📉 $1</Text></TouchableOpacity>
        </View>
      )}

      {tab==='Wallet' && (
        <ScrollView style={{padding:20}}>
          <View style={s.box}><Text style={s.label}>{type.toUpperCase()} BALANCE</Text><Text style={s.big2}>${balance.toLocaleString()}</Text></View>
          {type==='demo' && balance < 1000 && (
            <TouchableOpacity style={s.gold} onPress={resetDemo}><Text style={s.btnT}>RESET TO $10,000 🔄</Text></TouchableOpacity>
          )}
          <TouchableOpacity style={s.dark} onPress={()=>setType(type==='demo'?'real':'demo')}><Text style={s.darkT}>Switch to {type==='demo'?'REAL':'DEMO'}</Text></TouchableOpacity>
          <TouchableOpacity style={s.gold} onPress={()=>Alert.alert('M-Pesa','STK Push sent to +254')}><Text style={s.btnT}>Deposit M-Pesa 💚</Text></TouchableOpacity>
        </ScrollView>
      )}

      <View style={s.tabs}>
        <TouchableOpacity onPress={()=>setTab('Chats')} style={tab==='Chats'?s.aTab:s.tab}><Text style={s.tabTxt}>Chats</Text></TouchableOpacity>
        <TouchableOpacity onPress={()=>setTab('Trade')} style={tab==='Trade'?s.aTab:s.tab}><Text style={s.tabTxt}>Trade</Text></TouchableOpacity>
        <TouchableOpacity onPress={()=>setTab('Wallet')} style={tab==='Wallet'?s.aTab:s.tab}><Text style={s.tabTxt}>Wallet</Text></TouchableOpacity>
      </View>
    </View>
  );
}

const s = StyleSheet.create({
  container:{flex:1, backgroundColor:'#0A0A0A', paddingTop:35},
  header:{padding:15, borderBottomWidth:1, borderBottomColor:'#D4AF37', backgroundColor:'#000'},
  title:{color:'#D4AF37', fontSize:20, fontWeight:'900'},
  sub:{color:'#888', fontSize:11, marginTop:3},
  card:{padding:15, backgroundColor:'#141414', borderRadius:12, marginBottom:10, borderLeftWidth:3, borderLeftColor:'#D4AF37'},
  name:{color:'#D4AF37', fontWeight:'bold'}, msg:{color:'#CCC', marginTop:4},
  big:{color:'#FFF', fontSize:44, fontWeight:'900', marginTop:10},
  big2:{color:'#D4AF37', fontSize:36, fontWeight:'900', textAlign:'center'},
  gold:{backgroundColor:'#D4AF37', padding:16, borderRadius:12, marginTop:15, alignItems:'center'},
  dark:{backgroundColor:'#1A1A1A', padding:16, borderRadius:12, marginTop:15, alignItems:'center', borderWidth:1, borderColor:'#D4AF37'},
  btnT:{fontWeight:'900', color:'#000'}, darkT:{fontWeight:'bold', color:'#D4AF37'},
  tabs:{flexDirection:'row', borderTopWidth:1, borderTopColor:'#222', padding:8, backgroundColor:'#000'},
  tab:{flex:1, alignItems:'center', padding:12}, aTab:{flex:1, alignItems:'center', padding:12, backgroundColor:'#1A1A1A', borderRadius:10, borderWidth:1, borderColor:'#D4AF37'},
  tabTxt:{color:'#D4AF37', fontWeight:'bold', fontSize:12},
  box:{backgroundColor:'#141414', padding:20, borderRadius:16, alignItems:'center', borderWidth:1, borderColor:'#222'},
  label:{color:'gray', fontSize:11, letterSpacing:2}
});
